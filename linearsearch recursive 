#include <stdio.h>
int linearsearch(int a[], int size, int key, int i)
{
 if(i >= size)
 return 0;
 if(a[i] == key)
 return 1;
 return linearsearch(a, size, key, i+ 1);
}
int main()
{
 int n, key, i;
 printf("Enter the size of array: ");
 scanf("%d", &n);
 int arr[n];
 printf("Enter array elements: ");
 for(i = 0; i < n; i++)
 {
 scanf("%d", &arr[i]);}
 printf("Enter key value: ");
 scanf("%d", &key);
 if(linearsearch(arr, n, key, 0) == 1)
 printf("The key value %d is found", key);
 else
 printf("The key %d is not found", key);
return 0;
}
