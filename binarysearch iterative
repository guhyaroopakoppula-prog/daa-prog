#include<stdio.h>
int binarysearch(int a[], int start, int end, int key){
while(start <= end){
 int mid = (start+end)/2;
 if(a[mid]==key){
 return mid;
 }
 else if(a[mid]<key){
 start = mid+1;
 }
 else{
 end = mid-1;
 }
 }
 return -1;
}
int main(){
 int n; int key; int i;
 printf("Enter the size of array: ");
 scanf("%d", &n);
 int arr[n];
 printf("Enter array elements: ");
 for(i=0; i<n; i++){
 scanf("%d", &arr[i]);
 }
 printf("Enter key value: ");
 scanf("%d", &key);
 int result = binarysearch(arr, 0, n-1, key);
if(result != -1){
 printf("Key found at %d location", result);
 }
 else
 printf("Key not found");
 return 0;
}
