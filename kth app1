#include <stdio.h>
void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}
int  Smallest(int arr[], int n, int k) {
    int i, j;
    for (i= 0; i < n - 1; i++) {
        for (j = 0; j < n - i- 1; j++) {
            if (arr[j] > arr[j + 1])
                swap(&arr[j], &arr[j + 1]);
        }
    }
    return arr[k -1];
}
int main() {
    int n, k, i;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    int arr1[n];
    printf("Enter %d elements: ", n);
    for (i = 0; i < n; i++) {
        scanf("%d", &arr1[i]);
    }
    printf("Enter K: ");
    scanf("%d", &k);
    printf("small :    %d-th smallest = %d\n", k, Smallest(arr1, n, k));
    return 0;
}
//Time complexity -O(n²)
