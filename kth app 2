#include <stdio.h>
int smallest(int arr[], int n, int k) {
    int i, j, count;
    for (i = 0; i< n; i++) {
        count = 0;
        for (j = 0; j < n; j++) {
           if (arr[j] < arr[i])
                count++;
        }
        if (count == k -1)
            return arr[i];
    }
    return -1;
}
int main() {
    int n, k, i;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    int arr2[n];
    printf("Enter %d elements: ", n);
    for (i= 0; i < n; i++) {
        scanf("%d", &arr2[i]);
    }
    printf("Enter K: ");
    scanf("%d", &k);
    printf("smallest : %d-th smallest = %d\n", k, smallest(arr2, n, k));
    return 0;
}
