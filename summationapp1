#include <stdio.h>
#include <math.h>
float summation(float a, float r, int n)
{
    float sum = 0;
    sum = a * (pow(r, n) -1) / (r -1);
    return sum;
}
int main()
{
    float a, r;
    int n;
    printf("Enter a (1st term): ");
    scanf("%f", &a);
    printf("Enter r (common ratio): ");
    scanf("%f", &r);
    printf("Enter n (number of terms): ");
    scanf("%d", &n);
    printf("Sum = %f\n", summation(a, r, n));
    return 0;
}
//Time complexity -O(1)